# Round-robin in front of two baas nodes: the management API / dashboard on 8080, the data plane on 8081.
# The Host header is passed through untouched, because the data plane routes by <ref>.<domain>.
{
	auto_https off
	admin off
}

:8080 {
	reverse_proxy baas:8080 baas2:8080 {
		lb_policy round_robin
		lb_try_duration 5s
		health_uri /healthz
		health_interval 3s
		health_timeout 2s
	}
}

:8081 {
	reverse_proxy baas:8081 baas2:8081 {
		lb_policy round_robin
		lb_try_duration 5s
		# The data plane has no health route; a node that refuses connections is skipped.
		fail_duration 10s
		max_fails 1
	}
}
