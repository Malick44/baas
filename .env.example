# Copy to .env. All four are required by docker-compose.yml.
POSTGRES_PASSWORD=change-me                 # password of the Postgres superuser
BAAS_MASTER_KEY=                            # openssl rand -hex 32  — keep this safe: it decrypts every project's secrets
BAAS_BOOTSTRAP_TOKEN=                       # openssl rand -hex 24  — authorises creating organisations

# Optional
# BAAS_GATEWAY_DOMAIN=localhost             # projects are served at <ref>.<domain>
# BAAS_PUBLIC_SCHEME=http
# BAAS_PUBLIC_PORT=8081
# Email (optional): confirmation, password reset and magic-link emails. Without it those flows are off and sign-ups are confirmed automatically.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM="My App <no-reply@example.com>"
# Ask AI (optional): set a key to offer the plain-language SQL assistant. Projects still opt in individually,
# and their questions, table structure and query results are then sent to Anthropic.
# ANTHROPIC_API_KEY=
# BAAS_AI_MODEL=claude-opus-5-5
# BAAS_AI_EFFORT=medium
# BAAS_AI_FALLBACKS=on                      # "off" for platforms without server-side refusal fallbacks

# HTTPS with automatic certificates (docker-compose.tls.yml): see "Production" in the README.
# DOMAIN=example.com
# DASHBOARD_HOST=baas.example.com
# Where members reach the dashboard, for links in password reset emails (derived from DASHBOARD_HOST when that is set)
# BAAS_DASHBOARD_URL=https://baas.example.com
# ACME_EMAIL=you@example.com

# Edge functions: they may not reach private or local addresses. List exceptions, or set BAAS_FUNCTION_EGRESS=open to lift the rule.
# BAAS_FUNCTION_EGRESS_ALLOW=internal-api.local:8443
# BAAS_FUNCTION_EGRESS=public

# Phone sign-in by text message (Twilio). All three are needed; TWILIO_FROM is a number or a messaging service SID (MG…)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
