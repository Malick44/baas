{
  "name": "baas",
  "private": true,
  "type": "module",
  "description": "Self-hosted, multi-project Supabase-style platform",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/function-runner.mjs dist/",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "e2e": "node --import tsx --test --test-timeout=300000 e2e/dashboard.e2e.ts"
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "pg": "^8.13.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.18.1",
    "playwright-core": "^1.63.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "undici": "^8.11.2"
  },
  "bin": {
    "baas": "bin/baas.mjs"
  },
  "files": [
    "dist",
    "migrations",
    "dashboard",
    "bin"
  ],
  "engines": {
    "node": ">=22.13"
  }
}
